# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# En Vercel, estas mismas variables se ponen en
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# --- General -------------------------------------------------
# Nombre de la plataforma (el que verán los negocios)
NEXT_PUBLIC_APP_NAME="Tarjeta de Puntos"
# URL pública de la app, sin barra al final.
# En local: http://localhost:3000 · En producción: https://tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Fase 1-2) -------------------------------------
# Supabase → tu proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ⚠️ Clave secreta: solo en el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Google Wallet (Fase 3) ----------------------------------
# Google Pay & Wallet Console → Google Wallet API → "Issuer ID"
GOOGLE_WALLET_ISSUER_ID=
# El archivo JSON de la cuenta de servicio, convertido a base64
# (usa: npm run a-base64 -- ruta/al/archivo.json)
GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=

# --- Apple Wallet (Fase 4 y 6) -------------------------------
# developer.apple.com → Membership → Team ID (10 caracteres)
APPLE_TEAM_ID=
# El identificador que registres, p. ej. pass.com.tudominio.fidelizacion
APPLE_PASS_TYPE_ID=
# Certificado del Pass Type ID en formato .pem, en base64
APPLE_PASS_CERT_BASE64=
# Clave privada del certificado (.pem), en base64
APPLE_PASS_KEY_BASE64=
# Contraseña de la clave privada (si le pusiste una al exportarla)
APPLE_PASS_KEY_PASSPHRASE=
# Certificado intermedio de Apple "WWDR G4" (.pem), en base64
APPLE_WWDR_CERT_BASE64=
# Secreto aleatorio que firma los tokens de autenticación de los pases.
# Genera uno con: openssl rand -hex 32
APPLE_PASS_AUTH_SECRET=
